# Generated by cannbot-skills init.sh -- absolute symlinks and a CLAUDE.md with
# substituted absolute paths, both per-machine. Regenerate with:
#   bash cannbot-skills/plugins-official/pypto-pro-op-orchestrator/init.sh project claude
#
# Ignore the whole directory rather than enumerating entries: init.sh creates
# agents/, hooks/, plugins/, pypto-pro-op-kb, references/, skills/ and
# cannbot-manifest.json, and the enumerated list had already fallen behind --
# hooks/, plugins/ and the renamed pypto-pro-op-kb were not being ignored, and the
# stale `kb` entry no longer matched anything. Nothing under .claude/ is tracked.
/.claude/
/CLAUDE.md

# PyPTO-Pro devkit cache. Bare pattern, not `.devkit/`: a trailing slash matches
# directories only, and init.sh installs symlinks, which the bare form also covers.
.devkit

