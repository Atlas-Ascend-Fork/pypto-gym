# PyPTO-Pro Cube fragment: reuse one fixed left tile across a small output
# wave without changing partition ownership or the FP32 reduction tree.
# Derive constants/types/groups from the verified resource plan; this is not standalone code.

OUTPUT_GROUP = 4
output_waves = (output_tiles + OUTPUT_GROUP - 1) // OUTPUT_GROUP
tasks_per_row = partitions * output_waves
total_tasks = row_tiles * tasks_per_row

# Keep explicit handles because TileGroup has a rotating `next()` cursor, not
# random indexing. Four Acc slots must remain live until the whole K loop ends.
acc0 = acc_group.next()
acc1 = acc_group.next()
acc2 = acc_group.next()
acc3 = acc_group.next()

for task in pl.range(physical_id, total_tasks, num_cores):
    mt = task // tasks_per_row
    local_task = task % tasks_per_row
    partition = local_task // output_waves
    output_wave = local_task % output_waves
    nt_base = output_wave * OUTPUT_GROUP

    for q in pl.range(0, k_waves):
        k_block = q * partitions + partition

        # One Mat/Left tile is shared only by outputs from the same partition
        # and K block. Do not rotate it until every live Acc has consumed it.
        a_mat = a_mat_group.next()
        a_left = a_left_group.next()
        pl.load_tile(a_mat, input_2d, [mt, k_block])
        pl.move(a_left, a_mat)

        # Write the phase sequence out per Acc. Do NOT factor it into a Python
        # helper: the parser cannot follow a helper call inside a `@pl.jit`
        # body -- the body is an AST that is never executed, so the call
        # surfaces as a pybind "incompatible constructor arguments" error far
        # from the mistake. Inline it, or lift it to a value the parser can see.
        #
        # Phase, per Acc chain, using the two ends of the K loop rather than a
        # branch ladder: `q == 0` opens with `pl.matmul`, every later block
        # accumulates, and the *last* block must close with `AccPhase.Final`.
        # An accumulator left on `AccPhase.Partial` stays open and faults the
        # device, so the closing block cannot be reachable only when the loop
        # runs more than once -- a single-block chain (`k_waves == 1`) has to
        # open and close on the same iteration. `partition` is already fixed by
        # the outer task and is not another step in this Acc chain.
        is_first = q == 0
        is_last = q == k_waves - 1
        acc_phase = pl.AccPhase.Final if is_last else pl.AccPhase.Partial

        # for each live output lane, guarded by its tail check:
        #   if is_first:
        #       pl.matmul(accN, a_left, rhs_right, phase=acc_phase)
        #   else:
        #       pl.matmul_acc(accN, accN, a_left, rhs_right, phase=acc_phase)
        # Keep the calls unrolled so every lane has a stable Acc handle and the
        # tail guards stay visible; replace `rhs_right` with the Right tile this
        # lane's `nt` maps to, loaded from its own group.
        if nt_base < output_tiles:
            ...  # lane 0 -> acc0
        if nt_base + 1 < output_tiles:
            ...  # lane 1 -> acc1
        if nt_base + 2 < output_tiles:
            ...  # lane 2 -> acc2
        if nt_base + 3 < output_tiles:
            ...  # lane 3 -> acc3

    # Each [mt, partition, nt] partial remains a unique GM destination.
    if nt_base < output_tiles:
        pl.store_tile(partial_3d, acc0, [mt, partition, nt_base], phase=pl.STPhase.Final)
    if nt_base + 1 < output_tiles:
        pl.store_tile(partial_3d, acc1, [mt, partition, nt_base + 1], phase=pl.STPhase.Final)
    if nt_base + 2 < output_tiles:
        pl.store_tile(partial_3d, acc2, [mt, partition, nt_base + 2], phase=pl.STPhase.Final)
    if nt_base + 3 < output_tiles:
        pl.store_tile(partial_3d, acc3, [mt, partition, nt_base + 3], phase=pl.STPhase.Final)
