# Core identity is derived *inside each section*, never once at kernel scope.
# `get_block_idx()` lowers differently for AIC and AIV, so a single kernel-scope
# value captured by both sections is not one number -- it is two, and the Cube
# and Vector owner maps silently disagree. The cost of recomputing it is a
# scalar; the cost of sharing it is a wrong owner map that still runs.
#
# Before JIT, detect the AIV index generation with
# `hasattr(pl, "get_subblock_num")` and write 2 for interleaved AIV ids or 1 for
# physical-block ids to an operator-owned tiling scalar, shown below as
# `tiling.vector_task_ratio`. Rename the field when adapting this skeleton. The
# kernel source must not name an operator absent from an older registry.

with pl.section_cube():
    cube_physical_id = pl.get_block_idx()
    cube_num_cores = pl.get_block_num()

    total_cube_tasks = row_tiles * output_tiles
    if cube_physical_id < cube_num_cores:
        for task in pl.range(cube_physical_id, total_cube_tasks, cube_num_cores):
            mt = task // output_tiles
            nt = task % output_tiles
            # Load and compute exactly one disjoint [mt, nt] output tile.
            # Write the stage body inline: the parser walks a `@pl.jit` body as
            # an AST and never executes it, so it cannot follow a call into a
            # plain Python helper.
            ...  # loads, matmul phase chain and store for [mt, nt]

    # Producer side: every launched AIC reaches this barrier.
    pl.system.sync_all(core_type=pl.SyncCoreType.MIX)

with pl.section_vector():
    # Consumer side paired with the preceding Cube barrier.
    pl.system.sync_all(core_type=pl.SyncCoreType.MIX)
    # Same rule as the Cube section: derive identity here, not at kernel scope.
    vec_raw_core_id = pl.get_block_idx()
    vec_num_cores = pl.get_block_num()
    vector_physical_id = vec_raw_core_id // tiling.vector_task_ratio
    sub_id = pl.get_subblock_idx()

    # Conservative path: both AIV subblocks may share MTE, so only subblock 0
    # issues GM traffic. Dual-AIV ownership is a separate optimization item and
    # must not be enabled anonymously inside this task-flatten template.
    if sub_id == 0 and vector_physical_id < vec_num_cores:
        total_vec_tasks = row_tiles * output_chunks
        for task in pl.range(vector_physical_id, total_vec_tasks, vec_num_cores):
            mt = task // output_chunks
            chunk = task % output_chunks
            ...  # vector stage body, written inline (see the Cube note above)

    # Never move this barrier into the sub_id or tail guard.
    pl.system.sync_all(core_type=pl.SyncCoreType.MIX)

with pl.section_cube():
    # Paired consumer side for the preceding Vector barrier.
    pl.system.sync_all(core_type=pl.SyncCoreType.MIX)
    # Next flattened Cube stage follows the same unique-writer pattern.
    ...  # next flattened Cube stage, written inline

# Multi-wave vector ownership must be expressed in the vector chunk domain.
# Do not use a head count as a chunk count.  For example, a 72/56 head split
# with per_head_width=512 and vector_width=128 owns 288/224 chunks, not 72/56
# and not a doubled 576/448.  Audit both disjointness and exact total coverage.
chunks_per_head = per_head_width // vector_width
wave0_chunks = wave0_heads * chunks_per_head
wave1_chunks = wave1_heads * chunks_per_head
total_chunks = total_heads * chunks_per_head
assert wave0_chunks + wave1_chunks == total_chunks
