# PyPTO-Pro FP32-chain precision fragments
#
# Use only after replaying the candidate dataflow against the configured
# comparator proves that stagewise BF16 storage fails.  These are composable
# fragments, not a standalone kernel.  Shapes, addresses, mutex ids, phases,
# event ids, and API signatures still come from DESIGN.md and the installed SDK.
#
# Historical fragments, not current API or target acceptance. Current owner:
# ../../pypto-pro-kernel/references/api/numerics.md#preserve-intermediate-precision
# and the current mla_prolog example. The old fixed partial/component counts and
# CANN 9.1 conversion workaround below retain only that historical scope. Use
# current GEMM/VF owners and revalidate any adapted path; this file adds no
# tile-Vector-compute exception or new validated implementation.


# A. Deep-K projection: partition K blocks into four independent FP32 L0C
# accumulators, then store all four FP32 partials.  The four bodies must be
# written explicitly so every accumulator has a statically named first/last
# phase; require n_k_blocks % 4 == 0.  This first body is the copy pattern for
# acc1/acc2/acc3 with k_block offsets +1/+2/+3.
for q in pl.range(0, n_k_blocks // 4):
    k_block = q * 4
    # Load/move lhs0 and rhs0 for k_block into their selected groups.
    if q == 0:
        pl.matmul(acc0, lhs0, rhs0, phase=pl.AccPhase.Partial)
    elif q == n_k_blocks // 4 - 1:
        pl.matmul_acc(acc0, acc0, lhs0, rhs0, phase=pl.AccPhase.Final)
    else:
        pl.matmul_acc(acc0, acc0, lhs0, rhs0, phase=pl.AccPhase.Partial)
    # Repeat explicitly for acc1/acc2/acc3.  Do not use acc[part] or a runtime
    # part loop: PyPTO-Pro tile objects are compile-time handles, not a list
    # that can be dynamically indexed by a pl.range induction variable.
# Recombine downstream as (p0 + p1) + (p2 + p3), not left-to-right.


# B. Encode a computed FP32 Cube operand as three BF16 residual terms.  The
# intermediate widen/subtract stays FP32.  CAST_ROUND here is the validated
# residual encoding mode; do not replace it with the final-output mode.
pl.cast(term1_bf16, source_fp32, mode=pl.RoundMode.CAST_ROUND)
pl.cast(term1_fp32, term1_bf16, mode=pl.RoundMode.CAST_NONE)
subtract_vf(source_fp32, term1_fp32, residual_fp32)
pl.cast(term2_bf16, residual_fp32, mode=pl.RoundMode.CAST_ROUND)
pl.cast(term2_fp32, term2_bf16, mode=pl.RoundMode.CAST_NONE)
subtract_vf(residual_fp32, term2_fp32, residual2_fp32)
pl.cast(term3_bf16, residual2_fp32, mode=pl.RoundMode.CAST_ROUND)


# C. If one K128 three-term contraction still fails only at final BF16
# boundaries, keep the physical K128 Mat/Left/Right types but contract two
# compact K64 windows into distinct FP32 accumulators.  Repeat the three-term
# chain for k_offset 0 and 64; never alias the two live L0C values.
pl.set_validshape(mat_lhs, [valid_m, 64])
pl.set_validshape(mat_rhs, [64, valid_n])
pl.set_validshape(lhs_k0, [valid_m, 64])
pl.set_validshape(rhs_k0, [64, valid_n])
pl.move(lhs_k0, mat_lhs, offset=[0, 0])
pl.move(rhs_k0, mat_rhs, offset=[0, 0])
pl.matmul(acc_k0, lhs_k0, rhs_k0, phase=pl.AccPhase.Partial)
# Move K0 term2, then term3 through lhs_k0 and close with Partial, Final.
# Repeat explicitly for acc_k1/lhs_k1/rhs_k1 using offsets [0,64]/[64,0].
# Store acc_k0 and acc_k1 to distinct FP32 GM workspaces with STPhase.Final.


# D. Add FP32 K partials in VF and perform the only protocol conversion with
# RNE.  On A5 CAST_ROUND is tie-away; PyTorch BF16 output conversion is RNE.
add_fp32_vf(k0_fp32, k1_fp32, total_fp32, valid_rows, valid_cols)
pl.cast(output_bf16_tile, total_fp32, mode=pl.RoundMode.CAST_RINT)


# E. Materialize a BF16-high / FP32-low decomposition with Tile casts when a
# cancellation-sensitive consumer needs a hard rounding boundary.  Do not use
# vf.astype(... CAST_RINT) for FP32->BF16: the CANN 9.1 backend lowers it to an
# invalid ROUND_N vcvt mode.  Repeat this pair for every partial, then combine
# highs and lows with explicit pairwise trees in a basic VF helper.
pl.cast(high_bf16, partial_fp32, mode=pl.RoundMode.CAST_RINT)
pl.cast(high_fp32, high_bf16, mode=pl.RoundMode.CAST_NONE)
subtract_vf(partial_fp32, high_fp32, low_fp32)
# high = (high0 + high1) + (high2 + high3)
# low  = (low0  + low1)  + (low2  + low3)
# total = high + low
# This removes only the local reduction error.  It cannot reconstruct rounding
# already accumulated inside the upstream Cube partials, so validate the
# cancellation cases on every target CANN/hardware combination.
