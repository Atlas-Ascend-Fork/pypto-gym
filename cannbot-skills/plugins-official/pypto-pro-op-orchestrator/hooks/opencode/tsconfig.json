{
  "//": "Type-check lib/ with an available compiler: tsc --noEmit -p <this dir>.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["lib/**/*.ts"]
}
